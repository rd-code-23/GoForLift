{
  "name": "goforlift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "precheck": "pnpm --filter @goforlift/contracts build",
    "dev": "pnpm precheck && pnpm --parallel --filter @goforlift/web --filter @goforlift/api dev",
    "lint": "pnpm precheck && eslint .",
    "typecheck": "pnpm precheck && pnpm --recursive typecheck",
    "test": "pnpm precheck && pnpm --recursive test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --recursive build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
